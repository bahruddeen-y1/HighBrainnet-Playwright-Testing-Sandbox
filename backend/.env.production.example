# ============ Production env — copy เป็น .env.production แล้วกรอกค่าจริง ============
NODE_ENV=production
PORT=4000
APP_URL=https://your-domain.com
FRONTEND_URL=https://your-domain.com

# DATABASE_URL ถูก override โดย docker-compose (ใช้ DB_PASSWORD จาก .env รากโปรเจกต์)

# ============ Auth / JWT — ใช้ค่า random จริง: openssl rand -hex 32 ============
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
BCRYPT_COST=12

# ============ Bunny.net ============
BUNNY_API_KEY=
BUNNY_LIBRARY_ID=
BUNNY_CDN_HOSTNAME=
BUNNY_STREAM_TOKEN_KEY=
# ห้ามตั้ง BUNNY_MOCK ใน production

# ============ GB Prime Pay ============
GBP_MERCHANT_ID=
GBP_API_KEY=
GBP_SECRET_KEY=
GBP_WEBHOOK_SECRET=
# ห้ามตั้ง GBP_MOCK ใน production

# ============ Line Notify ============
LINE_NOTIFY_TOKEN=

# ============ Rate limit / CORS ============
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
CORS_ORIGIN=https://your-domain.com
