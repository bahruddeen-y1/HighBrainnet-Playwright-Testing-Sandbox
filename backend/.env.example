# ============ Server ============
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

# ============ Database (PostgreSQL) ============
DATABASE_URL="postgresql://highbrainnet:password@localhost:5432/highbrainnet?schema=public"

# ============ Auth / JWT ============
JWT_ACCESS_SECRET=replace_with_strong_random_64_chars
JWT_REFRESH_SECRET=replace_with_strong_random_64_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
BCRYPT_COST=12

# ============ Bunny.net (Video CDN) ============
BUNNY_API_KEY=
BUNNY_LIBRARY_ID=
BUNNY_CDN_HOSTNAME=
BUNNY_STREAM_TOKEN_KEY=

# ============ GB Prime Pay ============
GBP_MERCHANT_ID=
GBP_API_KEY=
GBP_SECRET_KEY=
GBP_WEBHOOK_SECRET=

# ============ Line Notify ============
LINE_NOTIFY_TOKEN=

# ============ Rate Limiting ============
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# ============ CORS ============
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
